{
  "name": "lich-an-nhien",
  "version": "1.1.3",
  "description": "Ứng dụng và Web Lịch Việt Nam (Lịch An Nhiên) tối ưu người cao tuổi",
  "scripts": {
    "dev:backend": "npm --prefix backend run dev",
    "dev:web": "npm --prefix web run dev",
    "dev:mobile": "npm --prefix mobile run start",
    "dev:mobile:tunnel": "npm --prefix mobile run start:tunnel",
    "dev:android": "npm --prefix mobile run android",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:web\"",
    "build:backend": "npm --prefix backend run build",
    "build:web": "npm --prefix web run build",
    "build": "npm run build:backend && npm run build:web",
    "test:calendar": "npx tsx shared/calendar/testCalendar.ts",
    "test": "npm run test:calendar"
  },
  "devDependencies": {
    "concurrently": "^9.2.4",
    "tsx": "^4.23.13"
  }
}
