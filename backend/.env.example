# Cấu hình dịch vụ gửi Email OTP qua Resend (https://resend.com)
# Nhận API key miễn phí tại: https://resend.com/api-keys
RESEND_API_KEY=

# Tên và email người gửi hiển thị (Mặc định dùng onboarding@resend.dev nếu chưa xác thực domain)
RESEND_FROM_EMAIL=Lịch An Nhiên <onboarding@resend.dev>

# Google OAuth 2.0 Client ID (Tạo miễn phí tại https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=

# Database MySQL Configuration (Khớp cấu hình Docker container mysql)
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=lich_an_nhien
DB_USERNAME=root
DB_PASSWORD="your_mysql_password"
